export TESTPOD_NAME=testpod

export NAMESPACE=mysql-operator

script_dir="$(cd "$(dirname "$0")" && pwd)"
basedir="$(cd "$script_dir/.." && pwd)"
python="${PYTHON:-python3}"

export PYTHONPATH="$basedir:$basedir/tests${PYTHONPATH:+:$PYTHONPATH}"

cd "$basedir" || exit 1

if [ "$#" -eq 0 ]; then
    set -- tests/unit
fi

"$python" -m pytest --version >/dev/null 2>&1
if [ "$?" -ne 0 ]; then
    echo "Could not run pytest with $python"
    echo "Install test dependencies, e.g.:"
    echo "  $python -m pip install pytest -r tests/requirements.txt"
    exit 1
fi

"$python" -m pytest "$@"
rc=$?
echo "Tests finished. rc=$rc"
exit "$rc"
